// Prisma schema file

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
// Stores
model Store {
  id                String      @id @default(uuid())
  name              String
  subdomain         String?     @unique
  plan              Plan        @default(FREE)
  status            StoreStatus @default(PENDING)
  // Monotonic counter for invoice numbers within this store. Bumped atomically
  // by `tx.store.update({ data: { lastInvoiceNumber: { increment: 1 } } })`
  // inside the invoice-creation transaction to avoid the read-then-write race
  // that `MAX(number) + 1` is vulnerable to under concurrency.
  lastInvoiceNumber Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  users             User[]
  products          Product[]
  customers         Customer[]
  invoices          Invoice[]
  debts             Debt[]
  creditEntries     CreditEntry[]
  paymentOps        DebtPaymentOperation[]

  @@map("stores")
}

enum Plan {
  FREE
  PRO
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Users
model User {
  id                    String    @id @default(uuid())
  username              String
  email                 String    @unique
  password              String
  role                  Role      @default(CASHIER)
  isActive              Boolean   @default(true)
  isEmailVerified       Boolean   @default(false)
  emailVerificationCode String?
  resetToken            String?   @unique
  resetTokenExpiry      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Foreign key — null for SUPER_ADMIN (platform-level user, no store)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([username, storeId]) // Same username can exist in different stores
  @@index([storeId, role])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CASHIER
}

// Products
model Product {
  id             String   @id @default(uuid())
  name           String
  barcode        String?
  price          Decimal  @db.Decimal(10, 2)
  wholesalePrice Decimal  @default(0) @db.Decimal(10, 2) // Cost / purchase price
  stock          Int      @default(0)
  minStock       Int      @default(5) // Low stock alert threshold
  // Carton definition — all three are set together or all left NULL.
  // NULL across the board means "this product is not sold by the carton",
  // which is every product that existed before this migration.
  piecesPerCarton     Int?
  cartonPurchasePrice Decimal? @db.Decimal(10, 2)
  cartonSalePrice     Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Foreign key
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Relations
  invoiceItems InvoiceItem[]

  @@unique([barcode, storeId]) // Barcode must be unique within a store
  @@index([storeId, isActive]) // covers the existing single-column lookup too
  @@index([storeId, name])     // for name search/order within a store
  @@map("products")
}

// Customers
model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String?

  // Money the shop is holding for this customer, from an overpayment. Never
  // negative — customer_credit_non_negative enforces that as a backstop, and
  // the service layer rejects the request long before the DB sees it. Kept in
  // lockstep with SUM(credit_entries.delta) by every write holding
  // SELECT ... FOR UPDATE on this row, the same way debts.paid tracks
  // debt_payments with no constraint tying them.
  creditBalance Decimal @default(0) @db.Decimal(10, 2)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Client-supplied idempotency key (the offline localId from IndexedDB).
  // Same idea as Invoice.clientInvoiceId: lets the server short-circuit
  // retries when the network drops between commit and response delivery,
  // so multiple page refreshes can't create the same customer twice.
  clientCustomerId String?

  // Foreign key
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Relations
  invoices  Invoice[]
  debts     Debt[]
  creditEntries CreditEntry[]
  paymentOps    DebtPaymentOperation[]

  @@unique([storeId, clientCustomerId]) // Idempotency: one customer per client key per store
  @@index([storeId, isDeleted])
  @@index([storeId, createdAt(sort: Desc)]) // paginated list ordered by recency
  @@index([storeId, name])                  // name search within a store
  @@map("customers")
}

// Invoices
model Invoice {
  id            String        @id @default(uuid())
  number        Int
  date          DateTime      @default(now())
  total         Decimal       @db.Decimal(10, 2)
  // Fixed-amount discount applied to the whole invoice at sale time.
  // `total` above is the NET (gross line sum − discount) because
  // invoice_balance_consistent requires paid + remaining = total; the gross
  // is derived as total + discount when a caller needs it.
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  paid          Decimal       @default(0) @db.Decimal(10, 2)
  remaining     Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Client-supplied idempotency key (the offline localId from IndexedDB).
  // Optional: only offline-synced invoices carry it. The (storeId, key) unique
  // index lets the server short-circuit retries when the network drops between
  // commit and response delivery — the client re-sends the same key and we
  // return the already-created invoice instead of creating a duplicate.
  // NULL values are allowed (and PostgreSQL treats multiple NULLs as distinct
  // in unique indexes), so legacy/online-only flows aren't constrained.
  clientInvoiceId String?

  // Foreign keys
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Relations
  items         InvoiceItem[]
  debt          Debt?

  @@unique([number, storeId]) // Invoice number must be unique within a store
  @@unique([storeId, clientInvoiceId]) // Idempotency: one invoice per client key per store
  @@index([storeId, date(sort: Desc)])                  // list + dailySales
  @@index([storeId, paymentMethod, date])               // filtered list / reports
  @@index([storeId, customerId, date(sort: Desc)])      // customer history
  @@index([customerId])                                 // FK lookups
  @@map("invoices")
}

enum PaymentMethod {
  CASH      // Full cash payment
  ONLINE    // Online payment
  DEBT      // Full amount as debt
  PARTIAL   // Partial payment
}

// Whether an invoice line was sold as a loose piece or as a whole carton.
// Lines created before carton support existed are all piece sales, which is
// what the column default gives them.
enum SaleUnit {
  UNIT
  CARTON
}

// Invoice items
model InvoiceItem {
  id          String  @id @default(uuid())
  productName String  // Save the name at sale time
  barcode     String?
  price       Decimal @db.Decimal(10, 2)
  unitCost    Decimal @default(0) @db.Decimal(10, 2) // Cost frozen at sale time
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  // Historical snapshot of how this line was sold. `quantity` is counted in
  // `saleUnit`s (pieces or cartons); `stockQuantity` is always in pieces and
  // is the amount the stock ledger moved by.
  //
  // stockQuantity is NULLable rather than backfilled: its correct historical
  // value is per-row (= quantity), which no constant default can express, and
  // backfilling would mean writing to every existing line on production.
  // Read it through stockPiecesOf() in invoice-item.util.ts.
  saleUnit      SaleUnit @default(UNIT)
  stockQuantity Int?

  // Foreign keys
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// Where the money for a debt payment came from. Every payment that existed
// before customer credit was cash, which is what the column default gives
// them. A CREDIT payment is funded from customers.creditBalance and must be
// excluded from cash-revenue reporting and from the "has payments" guards
// that block editing or voiding an invoice.
enum PaymentSource {
  CASH
  CREDIT
}

// Directional on purpose. A single REVERSAL value would serve two opposite
// movements — credit handed back to the customer (delta > 0) and credit
// clawed back from them (delta < 0) — and the daily reports in
// InvoiceService.getDailySales could not tell which bucket an entry belongs
// to. Invariant: OVERPAYMENT and APPLIED_REVERSED always carry delta > 0;
// APPLIED_TO_DEBT and OVERPAYMENT_REVERSED always carry delta < 0.
enum CreditReason {
  OVERPAYMENT           // cash surplus became credit
  OVERPAYMENT_REVERSED  // surplus withdrawn (a cash payment was deleted)
  APPLIED_TO_DEBT       // credit spent settling a debt
  APPLIED_REVERSED      // credit returned (invoice deleted/edited, CREDIT payment deleted)
}

// Debts
model Debt {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2) // Original debt amount
  paid      Decimal  @default(0) @db.Decimal(10, 2)
  remaining Decimal  @db.Decimal(10, 2)
  isPaid    Boolean  @default(false)
  date      DateTime @default(now())
  updatedAt DateTime @updatedAt
  // null for opening-balance debts ("دين سابق - رصيد افتتاحي عند التأسيس")
  notes     String?

  // Foreign keys
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  // Nullable: null for opening-balance debts (no linked invoice).
  // @unique still enforces one debt per invoice for non-null values;
  // PostgreSQL allows multiple NULLs in a unique index.
  invoiceId  String?   @unique
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Relations
  payments   DebtPayment[]

  @@index([storeId, isPaid, date(sort: Desc)])    // outstanding-debts list, recency
  @@index([storeId, customerId, isPaid])          // per-customer unpaid lookup
  @@index([customerId])                            // FK lookups
  @@map("debts")
}

// Debt payments
model DebtPayment {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  notes     String?

  // Funding source. NOT cosmetic: a CREDIT payment must be excluded from the
  // `payments.length > 0` guards that block invoice edit/void, and reversed
  // back into creditBalance when it is deleted.
  source    PaymentSource @default(CASH)

  // Foreign key
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)

  // The customer-level pay operation that produced this row. NULL means "no
  // operation" — every payment written before this migration, and every
  // payment sync/push creates. Those never produced a surplus, so their
  // deletion behaves exactly as it does today.
  operationId String?
  operation   DebtPaymentOperation? @relation(fields: [operationId], references: [id])

  creditEntry CreditEntry?

  @@index([debtId, date(sort: Desc)])
  @@index([operationId])
  @@map("debt_payments")
}

// One customer-level pay operation. Needed because a single client action
// fans out into N DebtPayment rows plus at most one credit movement, so no
// existing row represents "the operation" — and DebtPayment has no storeId,
// so it cannot host @@unique([storeId, clientOperationId]) at all.
//
// A row is written for EVERY call, even when there is no surplus and no
// client key, so the key always has an anchor to attach to.
model DebtPaymentOperation {
  id                String   @id @default(uuid())
  // Client-supplied idempotency key (the offline outbox's stable id). NULL is
  // allowed and PostgreSQL treats multiple NULLs as distinct in a unique
  // index, so online-only calls are unconstrained — same trick as
  // invoices_storeId_clientInvoiceId_key.
  clientOperationId String?
  // The FULL amount the cashier took across the counter — not the part that
  // landed on debts. debt_payments only ever records the allocated portion, so
  // without this row a 150 handed over against a 100 debt is unrecoverable
  // after the response is gone.
  amount            Decimal  @db.Decimal(10, 2)
  // How that amount was split. Both are snapshots, deliberately stored rather
  // than derived: deleting an invoice cascades its debt_payments away, and a
  // derived figure would then silently rewrite history.
  //
  // Nullable, not DEFAULT 0 — rows written before these columns existed have an
  // UNKNOWN split, not a zero one, and the additive-only migration rule forbids
  // backfilling them. Reads fall back to deriving the split from the linked
  // payments and credit entries when these are null.
  appliedToDebt     Decimal? @db.Decimal(10, 2)
  addedToCredit     Decimal? @db.Decimal(10, 2)
  notes             String?
  // Set when the receipt is fully undone — every CASH payment it produced has
  // been deleted. Null means it still stands.
  //
  // The row itself is never deleted: it is the idempotency anchor, and dropping
  // it would let an offline device replay the same clientOperationId and take
  // the money a second time. A reversal is a new fact ABOUT the receipt, so
  // `amount` and the split stay exactly as they were recorded.
  //
  // Only a FULL reversal sets this. One operation can hold several payments —
  // 100 spread over two 50 debts — and deleting one of them undoes part of the
  // receipt, not the receipt.
  reversedAt        DateTime?
  date              DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  payments      DebtPayment[]
  creditEntries CreditEntry[]

  @@unique([storeId, clientOperationId])
  @@index([storeId, customerId, date(sort: Desc)])
  @@map("debt_payment_operations")
}

// Audit ledger for customers.creditBalance. SUM(delta) per customer must
// always equal the denormalized column; no CHECK can express that (PostgreSQL
// CHECKs are row-local), so the invariant is held by every writer taking
// SELECT ... FOR UPDATE on the customer row first.
model CreditEntry {
  id           String       @id @default(uuid())
  delta        Decimal      @db.Decimal(10, 2)
  // Snapshot of creditBalance immediately after this entry, so an auditor can
  // read one row instead of replaying the whole ledger.
  balanceAfter Decimal      @db.Decimal(10, 2)
  reason       CreditReason
  notes        String?
  date         DateTime     @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // The CREDIT payment this entry funded, when there is one. SetNull because
  // debt_payments cascade away with their debt (and so with their invoice),
  // and the ledger row has to outlive them.
  debtPaymentId String?      @unique
  debtPayment   DebtPayment? @relation(fields: [debtPaymentId], references: [id], onDelete: SetNull)
  operationId   String?
  operation     DebtPaymentOperation? @relation(fields: [operationId], references: [id])

  @@index([storeId, customerId, date(sort: Desc)])
  @@index([storeId, reason, date(sort: Desc)]) // daily-sales credit lines
  @@index([customerId])
  @@map("credit_entries")
}
